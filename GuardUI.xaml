<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JNT v2" Height="748" Width="920"
        MinHeight="620" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FC"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Foreground="#1F2937"
        UseLayoutRounding="True">

  <Window.Resources>
    <!-- 悬停提示：深色小气泡，默认样式在浅色背景上太素了 -->
    <Style TargetType="{x:Type ToolTip}">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ToolTip}">
            <Border Background="#F01F2937" CornerRadius="6" Padding="10,6" MaxWidth="320">
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="#B3FFFFFF"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="BorderBrush" Value="#26000000"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="BaseButton" TargetType="Button">
      <Setter Property="Foreground" Value="#1F2937"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#D8E0EC"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <!-- 悬停只提亮边框和轻微放大，不覆盖按钮自己的底色 -->
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#3D7BFA"/>
                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="#3D7BFA"/>
      <Setter Property="BorderBrush" Value="#3D7BFA"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <Style x:Key="WarnButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="#FFF6E5"/>
      <Setter Property="BorderBrush" Value="#F3D9A4"/>
      <Setter Property="Foreground" Value="#B45309"/>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="#FFF1F2"/>
      <Setter Property="BorderBrush" Value="#F5C2C9"/>
      <Setter Property="Foreground" Value="#BE123C"/>
    </Style>

    <Style x:Key="LightTextBox" TargetType="TextBox">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#1F2937"/>
      <Setter Property="BorderBrush" Value="#D8E0EC"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="CaretBrush" Value="#1F2937"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <!-- 背景层：默认浅色渐变，放了图就换成图片 -->
    <Rectangle x:Name="BgImage" Stretch="UniformToFill">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#FFFFFF" Offset="0"/>
          <GradientStop Color="#EEF4FF" Offset="0.55"/>
          <GradientStop Color="#F6F0FF" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <Rectangle x:Name="BgOverlay" Fill="Transparent"/>

    <Grid Margin="18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- 标题 -->
      <StackPanel Grid.Row="0">
        <TextBlock x:Name="TxtHead" Text="JNT v2" FontSize="22" FontWeight="SemiBold" Foreground="#0F172A"/>
        <TextBlock Text="校园网守卫 · 自动登录 / 掉线重连 / 会话保活"
                   Foreground="#64748B" FontSize="12" Margin="0,4,0,0"/>
      </StackPanel>

      <!-- 状态卡片 -->
      <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0">
            <TextBlock x:Name="TxtPhase" Text="读取中…" FontSize="26" FontWeight="SemiBold"
                       Foreground="#0F172A"
                       ToolTip="当前阶段：在线 / 已暂停 / 重连中 / 已停止自动重连 等"/>
            <TextBlock x:Name="TxtMessage" Text="" Foreground="#475569"
                       Margin="0,6,16,0" TextWrapping="Wrap"/>
          </StackPanel>

          <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock x:Name="TxtRun" Text="守护进程：—" Foreground="#334155"
                       ToolTip="守护进程是否在运行；进程号来自 state.json"/>
            <TextBlock x:Name="TxtUserIndex" Text="会话：—" Foreground="#64748B" Margin="0,4,0,0"
                       ToolTip="当前认证会话编号；有值说明这个会话归守护进程管，掉线能自动恢复"/>
            <TextBlock x:Name="TxtLogins" Text="今日重登：—" Foreground="#64748B" Margin="0,4,0,0"
                       ToolTip="今天由守护进程自动完成的重登次数，不含你手动登录"/>
            <TextBlock x:Name="TxtBudget" Text="" Foreground="#64748B" Margin="0,4,0,0"
                       ToolTip="掉线后自动重连的时间预算；用完会停手，等你手动登录一次"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 操作按钮 -->
      <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0"
                 ToolTipService.ShowOnDisabled="True">
        <Button x:Name="BtnStart" Content="启动" Style="{StaticResource PrimaryButton}"
                ToolTip="清除暂停状态，并确保守护进程正在运行"/>
        <Button x:Name="BtnPause" Content="暂停" Style="{StaticResource WarnButton}"
                ToolTip="暂停自动登录与保活。只写一个标志文件，不改计划任务、不需要管理员权限"/>
        <Button x:Name="BtnRestart" Content="重启" Style="{StaticResource BaseButton}"
                ToolTip="结束当前守护进程并重新拉起（会顺带清除暂停状态）"/>
        <Button x:Name="BtnOpenLog" Content="打开日志文件夹" Style="{StaticResource BaseButton}"
                ToolTip="在资源管理器里打开 %LOCALAPPDATA%\CampusNetGuard"/>
        <Button x:Name="BtnClearLog" Content="清理日志" Style="{StaticResource BaseButton}"
                ToolTip="删除 guard.log 和轮转出来的 guard.log.1；状态、配置、账号都不动"/>
        <Button x:Name="BtnUninstall" Content="卸载" Style="{StaticResource DangerButton}"
                ToolTip="删除计划任务、还原网卡设置并清理数据，会弹 UAC 确认"/>
      </WrapPanel>

      <!-- 账号与自启 -->
      <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="14,10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <TextBlock Text="账号" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                     Foreground="#64748B" Margin="2,0,14,0"/>
          <TextBlock x:Name="TxtAccount" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center"
                     Text="未录入账号" Foreground="#1F2937"
                     ToolTip="密码用 Windows DPAPI 加密存在本机，不联网上传"/>
          <Button x:Name="BtnEditCred" Grid.Row="0" Grid.Column="2" Content="录入 / 修改账号…"
                  Style="{StaticResource BaseButton}" Margin="0"
                  ToolTip="输入校园网学号和密码，加密保存到本机；保存后需要重启守护进程才生效"/>

          <TextBlock Text="自启" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                     Foreground="#64748B" Margin="2,10,14,0"/>
          <TextBlock x:Name="TxtAutoStart" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
                     Text="检查中…" Foreground="#1F2937" Margin="0,10,0,0"
                     ToolTip="登录 Windows 时是否自动拉起守护进程（计划任务 CampusNetGuard）"/>
          <Button x:Name="BtnInstall" Grid.Row="1" Grid.Column="2" Content="安装 / 修复开机自启"
                  Style="{StaticResource BaseButton}" Margin="0,10,0,0"
                  ToolTip="注册计划任务，让守护进程开机自动运行（会弹 UAC）"/>

          <TextBlock Text="脚本" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"
                     Foreground="#64748B" Margin="2,10,14,0"/>
          <TextBlock x:Name="TxtScript" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"
                     Text="检查中…" Foreground="#1F2937" Margin="0,10,0,0"
                     TextTrimming="CharacterEllipsis"
                     ToolTip="守护脚本 guard.ps1 所在目录。界面和脚本放一起最省事"/>
          <Button x:Name="BtnPickScript" Grid.Row="2" Grid.Column="2" Content="指定脚本目录…"
                  Style="{StaticResource BaseButton}" Margin="0,10,0,0"
                  ToolTip="如果界面和脚本没放在一起，点这里选中 guard.ps1 所在目录"/>
        </Grid>
      </Border>

      <!-- 外观 -->
      <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="14,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <TextBlock Text="外观" Grid.Column="0" VerticalAlignment="Center"
                     Foreground="#64748B" Margin="2,0,14,0"/>
          <TextBox x:Name="TxtTitle" Grid.Column="1" Style="{StaticResource LightTextBox}"
                   Text="JNT v2" ToolTip="窗口标题。改完按回车或点别处生效，会记住"/>
          <Button x:Name="BtnPickBg" Grid.Column="2" Content="选择背景图片…"
                  Style="{StaticResource BaseButton}" Margin="10,0,8,0"
                  ToolTip="从本地选一张图片作为窗口背景，会复制到程序目录"/>
          <Button x:Name="BtnResetBg" Grid.Column="3" Content="恢复默认背景"
                  Style="{StaticResource BaseButton}" Margin="0"
                  ToolTip="删掉自定义背景，回到默认的浅色渐变底"/>
        </Grid>
      </Border>

      <!-- 日志 -->
      <Border Grid.Row="5" Style="{StaticResource CardStyle}" Margin="0,10,0,0" Padding="14,10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="2,0,2,8">
            <TextBlock Text="运行日志" FontWeight="SemiBold" DockPanel.Dock="Left" Foreground="#334155"/>
            <TextBlock x:Name="TxtLogHint" Text="最近 200 行，自动刷新" DockPanel.Dock="Right"
                       HorizontalAlignment="Right" Foreground="#94A3B8" FontSize="12"/>
          </DockPanel>
          <Border Grid.Row="1" Background="#FBFCFE" BorderBrush="#E2E8F2" BorderThickness="1"
                  CornerRadius="8" Padding="2">
            <TextBox x:Name="TxtLog" Text=""
                     IsReadOnly="True" AcceptsReturn="True" BorderThickness="0"
                     Background="Transparent" Foreground="#243244"
                     FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"
                     Padding="10,8"
                     ToolTip="只读。想要完整日志点「打开日志文件夹」"/>
          </Border>
        </Grid>
      </Border>

      <!-- 底部 -->
      <TextBlock x:Name="TxtFooter" Grid.Row="6" Text="" Foreground="#94A3B8"
                 FontSize="11" Margin="2,10,0,0" TextTrimming="CharacterEllipsis"/>
    </Grid>
  </Grid>
</Window>
