<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JNT v2" Height="720" Width="940"
        MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FC"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Foreground="#1F2937"
        UseLayoutRounding="True">

  <Window.Resources>
    <Style TargetType="{x:Type ToolTip}">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ToolTip}">
            <Border Background="#F01F2937" CornerRadius="6" Padding="10,6" MaxWidth="320">
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="#B3FFFFFF"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="BorderBrush" Value="#26000000"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- 顶部导航按钮 -->
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Foreground" Value="#334155"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,7"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#EEF4FF"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="BaseButton" TargetType="Button">
      <Setter Property="Foreground" Value="#1F2937"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#D8E0EC"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#3D7BFA"/>
                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="#3D7BFA"/>
      <Setter Property="BorderBrush" Value="#3D7BFA"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>

    <Style x:Key="WarnButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Background" Value="#FFF6E5"/>
      <Setter Property="BorderBrush" Value="#F3D9A4"/>
      <Setter Property="Foreground" Value="#B45309"/>
    </Style>

    <Style x:Key="LightTextBox" TargetType="TextBox">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#1F2937"/>
      <Setter Property="BorderBrush" Value="#D8E0EC"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="CaretBrush" Value="#1F2937"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LightPasswordBox" TargetType="PasswordBox">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#1F2937"/>
      <Setter Property="BorderBrush" Value="#D8E0EC"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Rectangle x:Name="BgImage" Stretch="UniformToFill">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#FFFFFF" Offset="0"/>
          <GradientStop Color="#EEF4FF" Offset="0.55"/>
          <GradientStop Color="#F6F0FF" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <Rectangle x:Name="BgOverlay" Fill="Transparent"/>

    <Grid Margin="18,14,18,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- 顶部导航 + 标题 -->
      <DockPanel Grid.Row="0">
        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
          <TextBlock x:Name="TxtHead" Text="JNT v2" FontSize="18" FontWeight="SemiBold"
                     Foreground="#0F172A" HorizontalAlignment="Right"/>
          <TextBlock Text="校园网守卫" FontSize="11" Foreground="#94A3B8"
                     HorizontalAlignment="Right" Margin="0,2,0,0"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="NavOverview" Content="概览" Style="{StaticResource NavButton}"/>
          <Button x:Name="NavAccount" Content="账号" Style="{StaticResource NavButton}"/>
          <Button x:Name="NavSettings" Content="设置" Style="{StaticResource NavButton}"/>
          <Button x:Name="NavLogs" Content="日志" Style="{StaticResource NavButton}"/>
          <Button x:Name="NavAbout" Content="关于" Style="{StaticResource NavButton}"/>
        </StackPanel>
      </DockPanel>

      <!-- 页面容器 -->
      <Grid Grid.Row="1" Margin="0,12,0,0">

        <!-- ============ 概览 ============ -->
        <Grid x:Name="PageOverview">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock x:Name="TxtPhase" Text="读取中…" FontSize="26" FontWeight="SemiBold"
                           Foreground="#0F172A"
                           ToolTip="当前阶段：在线 / 已暂停 / 重连中 / 已停止自动重连 等"/>
                <TextBlock x:Name="TxtMessage" Text="" Foreground="#475569"
                           Margin="0,6,16,0" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="TxtRun" Text="守护进程：—" Foreground="#334155"
                           ToolTip="守护进程是否在运行"/>
                <TextBlock x:Name="TxtUserIndex" Text="会话：—" Foreground="#64748B" Margin="0,4,0,0"
                           ToolTip="当前认证会话编号；有值说明会话归守护进程管"/>
                <TextBlock x:Name="TxtLogins" Text="今日重登：—" Foreground="#64748B" Margin="0,4,0,0"
                           ToolTip="今天由守护进程自动完成的重登次数"/>
                <TextBlock x:Name="TxtBudget" Text="" Foreground="#64748B" Margin="0,4,0,0"
                           ToolTip="掉线后自动重连的时间预算"/>
              </StackPanel>
            </Grid>
          </Border>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0"
                      ToolTipService.ShowOnDisabled="True">
            <Button x:Name="BtnStart" Content="启动" Style="{StaticResource PrimaryButton}"
                    ToolTip="清除暂停状态，并确保守护进程正在运行"/>
            <Button x:Name="BtnPause" Content="暂停" Style="{StaticResource WarnButton}"
                    ToolTip="暂停自动登录与保活；不改计划任务、不需要管理员权限"/>
            <Button x:Name="BtnRestart" Content="重启" Style="{StaticResource BaseButton}"
                    ToolTip="结束当前守护进程并重新拉起（会顺带清除暂停状态）"/>
          </StackPanel>

          <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="14,12">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <TextBlock Text="账号" Grid.Row="0" Grid.Column="0" Foreground="#64748B" Margin="2,0,14,0"/>
              <TextBlock x:Name="TxtAccount" Grid.Row="0" Grid.Column="1" Text="未录入账号"
                         Foreground="#1F2937" TextTrimming="CharacterEllipsis"/>

              <TextBlock Text="自启" Grid.Row="1" Grid.Column="0" Foreground="#64748B" Margin="2,8,14,0"/>
              <TextBlock x:Name="TxtAutoStart" Grid.Row="1" Grid.Column="1" Text="检查中…"
                         Foreground="#1F2937" Margin="0,8,0,0"/>

              <TextBlock Text="脚本" Grid.Row="2" Grid.Column="0" Foreground="#64748B" Margin="2,8,14,0"/>
              <TextBlock x:Name="TxtScript" Grid.Row="2" Grid.Column="1" Text="检查中…"
                         Foreground="#1F2937" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
            </Grid>
          </Border>

          <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="14,12">
            <StackPanel>
              <TextBlock Text="最近日志" FontWeight="SemiBold" Foreground="#334155" Margin="2,0,0,6"/>
              <TextBox x:Name="TxtLogPreview" Text="" IsReadOnly="True" AcceptsReturn="True"
                       BorderThickness="0" Background="Transparent" Foreground="#475569"
                       FontFamily="Consolas, Microsoft YaHei UI" FontSize="11.5"
                       VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                       MaxHeight="120"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- ============ 账号 ============ -->
        <Grid x:Name="PageAccount" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <StackPanel>
              <TextBlock Text="校园网账号" FontWeight="SemiBold" Foreground="#334155"/>
              <TextBlock Text="密码用 Windows DPAPI 加密后只存本机，不会上传到任何地方。"
                         FontSize="11.5" Foreground="#94A3B8" Margin="0,4,0,12" TextWrapping="Wrap"/>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="学号" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                           Foreground="#64748B" Margin="0,0,12,10"/>
                <TextBox x:Name="TxtUser" Grid.Row="0" Grid.Column="1" Style="{StaticResource LightTextBox}"
                         Margin="0,0,0,10" ToolTip="就是认证页上那个用户名"/>

                <TextBlock Text="密码" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                           Foreground="#64748B" Margin="0,0,12,10"/>
                <PasswordBox x:Name="PwdMain" Grid.Row="1" Grid.Column="1"
                             Style="{StaticResource LightPasswordBox}" Margin="0,0,0,10"/>

                <TextBlock Text="确认" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"
                           Foreground="#64748B" Margin="0,0,12,0"/>
                <PasswordBox x:Name="PwdConfirm" Grid.Row="2" Grid.Column="1"
                             Style="{StaticResource LightPasswordBox}"/>
              </Grid>

              <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button x:Name="BtnSaveCred" Content="保存账号" Style="{StaticResource PrimaryButton}"/>
                <TextBlock x:Name="TxtCredState" VerticalAlignment="Center" Foreground="#64748B"
                           Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="开机自启" FontWeight="SemiBold" Foreground="#334155"/>
                <TextBlock x:Name="TxtAutoStartDetail" Text="检查中…" Foreground="#64748B"
                           Margin="0,6,16,0" TextWrapping="Wrap"/>
              </StackPanel>
              <Button x:Name="BtnInstall" Grid.Column="1" Content="安装 / 修复" VerticalAlignment="Center"
                      Style="{StaticResource BaseButton}" Margin="0"
                      ToolTip="注册计划任务让守护进程开机自动运行；顺带关掉 Windows 开机自动弹认证页（会弹 UAC）"/>
            </Grid>
          </Border>

          <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="脚本目录" FontWeight="SemiBold" Foreground="#334155"/>
                <TextBlock x:Name="TxtScriptDetail" Text="检查中…" Foreground="#64748B"
                           Margin="0,6,16,0" TextWrapping="Wrap"/>
              </StackPanel>
              <Button x:Name="BtnPickScript" Grid.Column="1" Content="指定目录…" VerticalAlignment="Center"
                      Style="{StaticResource BaseButton}" Margin="0"
                      ToolTip="界面和脚本没放一起时，选中 guard.ps1 所在目录"/>
            </Grid>
          </Border>
        </Grid>

        <!-- ============ 设置 ============ -->
        <Grid x:Name="PageSettings" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <StackPanel>
              <TextBlock Text="重连超时" FontWeight="SemiBold" Foreground="#334155"/>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBox x:Name="TxtTimeout" Width="70" Style="{StaticResource LightTextBox}"
                         ToolTip="分钟数，0 = 不限制"/>
                <TextBlock Text="分钟" VerticalAlignment="Center" Margin="8,0,12,0" Foreground="#64748B"/>
                <Button x:Name="BtnSaveTimeout" Content="保存" Style="{StaticResource BaseButton}"
                        Margin="0" ToolTip="保存后下一轮巡检生效（最多 30 秒）"/>
              </StackPanel>
              <TextBlock x:Name="TxtTimeoutHint" TextWrapping="Wrap" FontSize="11.5" LineHeight="17"
                         Foreground="#94A3B8" Margin="0,10,0,0"/>
            </StackPanel>
          </Border>

          <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="标题与背景" FontWeight="SemiBold" Foreground="#334155"/>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="标题" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,10,0"/>
                <TextBox x:Name="TxtTitle" Width="220" Style="{StaticResource LightTextBox}"/>
                <Button x:Name="BtnSaveTitle" Content="保存标题" Style="{StaticResource BaseButton}"
                        Margin="10,0,0,0"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="背景" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,10,0"/>
                <TextBlock x:Name="TxtBackground" Text="—" VerticalAlignment="Center"
                           Foreground="#475569" MaxWidth="260" TextTrimming="CharacterEllipsis"
                           Margin="0,0,10,0"/>
                <Button x:Name="BtnPickBg" Content="选择图片…" Style="{StaticResource BaseButton}"
                        Margin="0,0,8,0"/>
                <Button x:Name="BtnResetBg" Content="恢复默认" Style="{StaticResource BaseButton}" Margin="0"/>
              </StackPanel>
              <TextBlock Text="背景图会复制到程序目录；恢复默认会删掉自定义背景，回到同目录 bg.png 或浅色渐变。"
                         FontSize="11.5" Foreground="#94A3B8" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- ============ 日志 ============ -->
        <Grid x:Name="PageLogs" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <DockPanel Grid.Row="0" Margin="2,0,2,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
              <Button x:Name="BtnOpenLog" Content="打开文件夹" Style="{StaticResource BaseButton}"
                      Margin="0,0,8,0" ToolTip="在资源管理器里打开 %LOCALAPPDATA%\CampusNetGuard"/>
              <Button x:Name="BtnClearLog" Content="清理日志" Style="{StaticResource BaseButton}" Margin="0"
                      ToolTip="删除 guard.log 和 guard.log.1；状态、配置、账号都不动"/>
            </StackPanel>
            <TextBlock Text="运行日志" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#334155"/>
          </DockPanel>

          <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12,10">
            <TextBox x:Name="TxtLog" Text=""
                     IsReadOnly="True" AcceptsReturn="True" BorderThickness="0"
                     Background="Transparent" Foreground="#243244"
                     FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"
                     ToolTip="只读，显示最近 200 行"/>
          </Border>
        </Grid>

        <!-- ============ 关于 ============ -->
        <Grid x:Name="PageAbout" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <StackPanel>
              <TextBlock Text="江农校园网守卫 v2" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A"/>
              <TextBlock Text="自动登录 / 掉线重连 / 会话保活" Foreground="#64748B" Margin="0,4,0,16"/>
              <TextBlock x:Name="TxtAboutPaths" Text="" TextWrapping="Wrap" Foreground="#475569"
                         FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" LineHeight="20"/>
              <TextBlock Text="仓库：github.com/yi117/jxau-campus-net-v2" Foreground="#94A3B8"
                         Margin="0,16,0,0" FontSize="11.5"/>
              <TextBlock Text="源码在仓库里；不放心的话可以自己用 build.cmd 编译。"
                         Foreground="#94A3B8" Margin="0,4,0,0" FontSize="11.5"/>
            </StackPanel>
          </Border>

          <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,12,0,0"
                  Background="#FFF1F2" BorderBrush="#F5C2C9">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="卸载" FontWeight="SemiBold" Foreground="#BE123C"/>
                <TextBlock Text="删除计划任务、还原网卡设置和开机弹窗策略，账号与日志可以选保留。会弹 UAC 确认。"
                           Foreground="#9F1239" FontSize="11.5" Margin="0,6,16,0" TextWrapping="Wrap"/>
              </StackPanel>
              <Button x:Name="BtnUninstall" Grid.Column="1" Content="卸载…" VerticalAlignment="Center"
                      Style="{StaticResource BaseButton}" Margin="0"
                      Background="#FFF1F2" BorderBrush="#F5C2C9" Foreground="#BE123C"
                      ToolTip="调 uninstall.cmd，会弹 UAC"/>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <TextBlock x:Name="TxtFooter" Grid.Row="2" Text="" Foreground="#94A3B8"
                 FontSize="11" Margin="2,10,0,0" TextTrimming="CharacterEllipsis"/>
    </Grid>
  </Grid>
</Window>
